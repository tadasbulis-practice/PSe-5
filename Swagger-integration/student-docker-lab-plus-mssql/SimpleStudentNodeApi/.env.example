# Copy this file to .env and edit it (npm start reads .env; Docker and hosting use their own settings).
# .env is in .gitignore – passwords never go to GitHub.

PORT=6004
APP_ENVIRONMENT=Development
APP_DEBUG=true

# ---- SQL Server: the mssqlserver container from docker-compose.infra.yml ----
DB_DRIVER=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_NAME=StudentDb
DB_USER=sa
DB_PASSWORD=1Secure*Password1
DB_SSL=false

# ---- or PostgreSQL: the postgres container from docker-compose.postgres.yml ----
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=StudentDb
# DB_USER=postgres
# DB_PASSWORD=1Secure*Password1
# DB_SSL=false

# ---- or Supabase (Project → Connect → Session pooler). One line instead of DB_HOST ... DB_PASSWORD:
# DB_DRIVER=postgres
# DB_SSL=true
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
