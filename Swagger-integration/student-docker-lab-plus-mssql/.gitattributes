# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Must stay LF (they run inside Linux containers or bash)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.htaccess   text eol=lf
*.php       text eol=lf
*.sql       text eol=lf

# Must stay CRLF (Windows scripts)
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.sln       text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.jar  binary
*.zip  binary
