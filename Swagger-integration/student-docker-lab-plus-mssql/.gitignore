# =============================================================================
#  student-docker-lab-plus-mssql – .gitignore for every project type in here:
#  .NET (SimpleStudentApi, SimpleStudentFrontend), PHP (SimpleStudentPhpApi,
#  SimpleStudentPhpFrontend), Flutter/Dart (SimpleStudentMobile: Android + iOS),
#  Docker, IDEs and operating systems.
#  Patterns without a leading "/" work in every subfolder, so this file can be
#  copied together with the folder into any repository.
# =============================================================================

# ---------- Operating systems ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.directory
.Trash-*

# ---------- IDEs / editors ----------
# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.vsidx
*.rsuser
# JetBrains (Rider, PhpStorm, Android Studio, IntelliJ)
.idea/
*.iml
*.ipr
*.iws
# VS Code – keep shared settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
# Others
*.swp
*.swo
.atom/
*.sublime-workspace

# ---------- .NET / C# ----------
bin/
obj/
[Ll]og/
[Ll]ogs/
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml
publish/
*.nupkg
*.snupkg
.nuget/
project.lock.json
artifacts/
# Local secrets / overrides (appsettings.json and appsettings.Development.json stay in git)
appsettings.*.local.json
secrets.json

# ---------- PHP ----------
vendor/
composer.phar
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.php_cs.cache
phpstan.neon.local
*.sqlite
*.sqlite3
# environment files with passwords
.env
.env.*
!.env.example

# ---------- Flutter / Dart ----------
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
build/
coverage/
migrate_working_dir/
app.*.symbols
app.*.map.json

# ---------- Android (Gradle / Android Studio) ----------
.gradle/
.cxx/
.externalNativeBuild/
captures/
local.properties
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/key.properties
*.jks
*.keystore
**/android/**/GeneratedPluginRegistrant.java
gradle-wrapper.jar
*.apk
*.aab

