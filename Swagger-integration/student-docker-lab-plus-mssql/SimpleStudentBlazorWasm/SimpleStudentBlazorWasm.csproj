<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Blazor WebAssembly (standalone, .NET 8): the app is compiled to static files
       (HTML, CSS, .wasm, .dll) that the browser downloads and runs. Any web server can host them –
       the Docker image uses nginx. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
  </ItemGroup>

</Project>
